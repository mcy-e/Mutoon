                text: root.main_txt
                halign: "center"
                font_name:"fonts/NotoKufiArabic-ExtraBold.ttf"
                font_size:'12sp'
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                size_hint:1,0.8

