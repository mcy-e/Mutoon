<CustomImageButton>:
    #*  default properties

    orientation: 'vertical'
    size_hint: 0.5, None
    height: self.width * 0.33
    spacing: "10dp"
   # the custom image 

    Image:
        id:btn_bg
        source: root.source
        size_hint_y: 0.8
        allow_stretch: True
        keep_ratio: True

    # the custom label
    MDLabel:
        text: root.label_text
        halign: "center"
        size_hint_y: 0.2
        font_size: "15sp"
        font_name:"fonts/Amiri-Regular.ttf"
        color: (1, 1, 1, 1) if app.dark_app else (0,0,0,1)




