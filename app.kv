#custom widgets

<Info_popup>:
    size_hint: 0.8, 0.8
    background_color: (0.0, 0.302, 0.251, 1) if app.dark_app else (1.0, 0.973, 0.882, 1)
    auto_dismiss: True
    pos_hint: {'top': 0.9}
    MDCard:
        orientation: "vertical"
        radius: [15,]
        elevation: 4
        md_bg_color:(0.0, 0.302, 0.251, 1) if app.dark_app else (1.0, 0.973, 0.882, 1)
        MDBoxLayout:
            padding:"20dp"
            orientation: "vertical"
            MDCarousel:
                id:swiper
                size_hint:1,0.8   
                direction:'right'
                MDBoxLayout:
                    MDLabel:
                        text: root.info_txt
                        halign: "center"
                        font_name:"fonts/NotoKufiArabic-ExtraBold.ttf"
                        font_size:'15sp'
                        theme_text_color: "Custom"
                        text_color: (1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                MDBoxLayout:
                    Image:
                        source:"Images/1_d.png" if app.dark_app else "Images/1_l.png"  
                        keep_ratio:True,
                        size_hint:(1, 1)
                        allow_stretch:False
                        pos_hint:{'center_x': 0.5,'center_y': 0.5}
                MDBoxLayout:
                    Image:
                        source:"Images/2_d.png" if app.dark_app else "Images/2_l.png"  
                        keep_ratio:True,
                        size_hint:(1, 1)
                        allow_stretch:False
                        pos_hint:{'center_x': 0.5,'center_y': 0.5}
                MDBoxLayout:
                    Image:
                        source:"Images/3_d.png" if app.dark_app else "Images/3_l.png"  
                        keep_ratio:True,
                        size_hint:(1, 1)
                        allow_stretch:False
                        pos_hint:{'center_x': 0.5,'center_y': 0.5}
                MDBoxLayout:
                    Image:
                        source:"Images/4_d.png" if app.dark_app else "Images/4_l.png"  
                        keep_ratio:True,
                        size_hint:(1, 1)
                        allow_stretch:False
                        pos_hint:{'center_x': 0.5,'center_y': 0.5}
                MDBoxLayout:
                    Image:
                        source:"Images/5_d.png" if app.dark_app else "Images/5_l.png"  
                        keep_ratio:True,
                        size_hint:(1, 1)
                        allow_stretch:False
                        pos_hint:{'center_x': 0.5,'center_y': 0.5}
            MDRaisedButton:
                text: root.close_txt
                font_name:"fonts/NotoKufiArabic-ExtraBold.ttf"
                size_hint:0.5,0.1
                pos_hint: {'center_x': 0.5,'center_y': 0.5}
                on_release: 
                    root.dismiss()

<Socials_popup>:
    size_hint: 0.8, 0.5
    background_color: (0.0, 0.302, 0.251, 1) if app.dark_app else (1.0, 0.973, 0.882, 1)
    auto_dismiss: True
    pos_hint: {'top': 0.9}
    MDCard:
        orientation: "vertical"
        radius: [15,]
        elevation: 4
        md_bg_color:(0.0, 0.302, 0.251, 1) if app.dark_app else (1.0, 0.973, 0.882, 1)
        MDBoxLayout:
            padding:"10dp"
            orientation: "vertical"
            spacing:"20dp"
            MDLabel:
                text: root.main_txt
                halign: "center"
                vallign:"top"
                font_name:"fonts/NotoKufiArabic-ExtraBold.ttf"
                font_size:'12sp'
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                size_hint:1,0.1
            MDBoxLayout:
                orientation:"vertical"
                spacing:"10dp"
                size_hint:1,0.8
                
                MDRectangleFlatIconButton:
                    text:"instagram"
                    icon:"instagram"
                    size_hint:0.9,0.1
                    pos_hint: {'center_x': 0.5,'center_y': 0.5}
                    radius: [15,]
                    elevation:2
                    theme_text_color:"Custom"
                    text_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    icon_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    line_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    on_release:root.routes("https://www.instagram.com/reffaschouaib/")
                MDRectangleFlatIconButton:
                    text:"github"
                    icon:"github"
                    size_hint:0.9,0.1
                    pos_hint: {'center_x': 0.5,'center_y': 0.5}
                    radius: [15,]
                    elevation:2
                    theme_text_color:"Custom"
                    text_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    icon_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    line_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    on_release:root.routes("https://github.com/mcy-e")
                MDRectangleFlatIconButton:
                    text:"twitter"
                    icon:"twitter"
                    size_hint:0.9,0.1
                    pos_hint: {'center_x': 0.5,'center_y': 0.5}
                    radius: [15,]
                    elevation:2
                    theme_text_color:"Custom"
                    text_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    icon_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    line_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    on_release:root.routes("https://x.com/MRc_MCY")
                MDRectangleFlatIconButton:
                    text:"gmail"
                    icon:"gmail"
                    size_hint:0.9,0.1
                    pos_hint: {'center_x': 0.5,'center_y': 0.5}
                    radius: [15,]
                    elevation:2
                    theme_text_color:"Custom"
                    text_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    icon_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    line_color:(1, 1, 1, 1) if app.dark_app else (0.2,0.2,0.2,1)
                    on_release:root.routes("mailto:reffaschouaib@gamil.com")
            MDRaisedButton:
                text: root.close_txt
                font_name:"fonts/NotoKufiArabic-ExtraBold.ttf"
                size_hint:0.5,0.2
                pos_hint: {'center_x': 0.5,'center_y': 0.5}
                on_release: root.dismiss()
<Gift_popup>:
    size_hint: 0.8, 0.3
    background_color: (0.0, 0.302, 0.251, 1) if app.dark_app else (1.0, 0.973, 0.882, 1)
    auto_dismiss: True

    MDCard:
        orientation: "vertical"
        radius: [15,]
        elevation: 4
        md_bg_color:(0.0, 0.302, 0.251, 1) if app.dark_app else (1.0, 0.973, 0.882, 1)
        MDBoxLayout:
            padding:"10dp"
            orientation: "vertical"
            spacing:"10dp"
