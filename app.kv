                            pos_hint: {'x': 0.03,'center_y': 0.5} 
                            ripple_alpha:0 
                            on_press:
                                nav_drawer.md_bg_color=(0.0, 0.302, 0.251, 1) if app.dark_app else (0.941, 0.918, 0.839, 1)
                                nav_drawer.set_state("open")


                        MDIconButton:
                            opacity:0
                            id:back_btn
                            icon:"arrow-left"
                            theme_text_color:"Custom"
                            text_color:(0.0, 0.302, 0.251, 1) if  not app.dark_app else (1.0, 0.973, 0.882, 1)
                            pos_hint: {'right': 1,'center_y': 0.5} 
                            ripple_alpha:0 
                            on_press:
                                self.opacity=0
                                root.ids.menu_btn.opacity=0
                                root.ids.title.opacity=0
                                app.root.current="main"                                
                            
                                
                                

                    Mojmel_pages:
                        size_hint_y: 0.91 
                        size_hint_x: 1
                        
                        id:page


        MDNavigationDrawer:
            id: nav_drawer
            md_bg_color:(0.004, 0.267, 0.129, 1) if app.dark_app else (0.941, 0.918, 0.839, 1)
            BoxLayout:
                orientation: 'vertical'

                
                ScrollView:
                    MDList:
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '10dp'
                        MDRectangleFlatButton:
                            text:root.sections[0]
                            font_name:"arb_fnt"
                            text_color:(0.9,0.9,0.9,1) if app.dark_app else (0.1,0.1,0.1,1)
                            line_color: (0.9,0.9,0.9,1) if app.dark_app else (0.1,0.1,0.1,1)
                            ripple_color: 0.2, 0.2, 0.2, 0.1
                            size_hint_x:1
                            size_hint_y:0.2
                            on_release:
                                root.ids.page.load_section(1)
                                root.ids.nav_drawer.set_state("close")
                        
                        MDRectangleFlatButton:
                            text:root.sections[1]
                            font_name:"arb_fnt"
                            text_color:(0.9,0.9,0.9,1) if app.dark_app else (0.1,0.1,0.1,1)
                            line_color: (0.9,0.9,0.9,1) if app.dark_app else (0.1,0.1,0.1,1)
                            ripple_color: 0.2, 0.2, 0.2, 0.1
                            size_hint_x:1
                            size_hint_y:0.2
                            on_release:
                                root.ids.page.load_section(4)
                                root.ids.nav_drawer.set_state("close")
                        
                MDLabel:
                    size_hint_y:0.05
                    size_hint_x:1
                    pos_hint: {'center_x': 0.5,'center_y': 0.5}
                    text:root.copyright 
                    font_name:"arb_fnt"
                    font_size:"7sp"
                    color:(0.9,0.9,0.9,1) if app.dark_app else (0.1,0.1,0.1,1)
                    halign:"center" 
                    vallign:"center"                    
                           
                                
                           


