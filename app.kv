            Screen:
                MDBoxLayout:
                    orientation: 'vertical'
                    MDFloatLayout:
                        id:top_menu
                        size_hint_y:0.09
                        md_bg_color:(0.0, 0.302, 0.251, 1) if app.dark_app else (0.941, 0.918, 0.839, 1)
                       
                        MDLabel:
                            opacity:0
                            id:title
                            text:root.title
                            pos_hint: {'x':0.19,'center_y': 0.5}
                            color:(0.0, 0.302, 0.251, 1) if  not app.dark_app else (1.0, 0.973, 0.882, 1)
