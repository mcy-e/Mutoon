                                root.ids.page.load_section(155)
                                root.ids.nav_drawer.set_state("close")



                MDLabel:
                    size_hint_y:0.05
                    size_hint_x:1
                    pos_hint: {'center_x': 0.5,'center_y': 0.5}
                    text:root.copyright 
                    font_name:"arb_fnt"
                    font_size:"7sp"
                    color:(0.9,0.9,0.9,1) if app.dark_app else (0.1,0.1,0.1,1)
                    halign:"center" 
                    vallign:"center"                             
                           
                                
                           



<IBN_B_E_Screen>: 
    MDNavigationLayout:
        md_bg_color:1,1,1,1
        ScreenManager:
            Screen:
                MDBoxLayout:
                    orientation: 'vertical'
                    MDFloatLayout:
                        id:top_menu
                        size_hint_y:0.09
                        md_bg_color:(0.0, 0.302, 0.251, 1) if app.dark_app else (0.941, 0.918, 0.839, 1)
                       
                        MDLabel:
                            opacity:0
                            id:title
                            text:root.title
                            pos_hint: {'x':0.15,'center_y': 0.5}
                            color:(0.0, 0.302, 0.251, 1) if  not app.dark_app else (1.0, 0.973, 0.882, 1)
                            font_name:"arb_fnt"
                            halign: "center"
                            size_hint_y: 0.2
                            font_size: "18sp"
                        MDIconButton:
                            opacity:0
                            id:menu_btn
                            icon:"menu"
                            disabled: 'True'
                            theme_text_color:"Custom"
                            text_color:(0.0, 0.302, 0.251, 1) if  not app.dark_app else (1.0, 0.973, 0.882, 1)
                            pos_hint: {'x': 0.03,'center_y': 0.5} 
                            ripple_alpha:0 
                            on_press:
                                nav_drawer.md_bg_color=(0.0, 0.302, 0.251, 1) if app.dark_app else (0.941, 0.918, 0.839, 1)
                                nav_drawer.set_state("open")


                        MDIconButton:
                            opacity:0
                            id:back_btn
                            icon:"arrow-left"
                            theme_text_color:"Custom"
                            text_color:(0.0, 0.302, 0.251, 1) if  not app.dark_app else (1.0, 0.973, 0.882, 1)
                            pos_hint: {'right': 1,'center_y': 0.5} 
                            ripple_alpha:0 
                            on_press:
                                self.opacity=0
                                root.ids.menu_btn.opacity=0
                                root.ids.title.opacity=0
                                app.root.current="main"                                
                            
                                
                                

                    IBN_B_E_pages:
                        size_hint_y: 0.91 
                        size_hint_x: 1
                        
                        id:page
                        MDLabel:
                            text:app.not_available
                            font_name:"arb_fnt"
                            font_size:"20sp"
                            color:(0,0,0,1)
                            halign:"center"


        MDNavigationDrawer:
            id: nav_drawer
            md_bg_color:(0.004, 0.267, 0.129, 1) if app.dark_app else (0.941, 0.918, 0.839, 1)
            BoxLayout:
                orientation: 'vertical'

                
                ScrollView:
                     
                    do_scroll_x: False
                    do_scroll_y: True
                    
                    MDList:

                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "10dp"
                        
                        height: self.minimum_height
                        spacing: '10dp'
                  
                        # MDRectangleFlatButton:
                        #     text:root.sections[4]
